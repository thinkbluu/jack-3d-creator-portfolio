# Website checker (/verifica-site) — variables to configure in Vercel.
# Everything else the site needs is already set on the project.

# Google PageSpeed Insights API key (https://developers.google.com/speed/docs/insights/v5/get-started).
# Optional: without it the speed category is reported as "unverified" and the
# overall score averages the remaining categories. Free tier: 25 000 checks/month.
PAGESPEED_API_KEY=

# Already required by the contact form — the PDF report email reuses it.
# Without it the report form still works but the email is skipped (logged only).
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
