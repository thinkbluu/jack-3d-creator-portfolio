# Website checker (/verifica-site) — variables to configure in Vercel.
# Everything else the site needs is already set on the project.

# Google PageSpeed Insights API key (https://developers.google.com/speed/docs/insights/v5/get-started).
# Optional: without it the speed category is reported as "unverified" and the
# overall score averages the remaining categories. Free tier: 25 000 checks/month.
PAGESPEED_API_KEY=

# Already required by the contact form — the PDF report email reuses it.
# Without it the report form still works but the email is skipped (logged only).
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# IndexNow key (Bing, Yandex, Seznam, Naver). The key file is hosted at
# public/<key>.txt and scripts/indexnow.mjs submits changed URLs after every
# production deploy. Change the key here AND rename the file in public/.
# Optional: the script falls back to the current key baked into it.
INDEXNOW_KEY=a63723ef725e4063aa9195084ed1385b

# Bing Webmaster Tools verification code, rendered as
# <meta name="msvalidate.01"> in <head> only when set.
# Get it from https://www.bing.com/webmasters after verifying the site.
BING_SITE_VERIFICATION=
